{
  "manifest_version": 3,
  "name": "QuesadillAI",
  "version": "1.0.0",
  "description": "Replace every standalone instance of AI on webpages with a word of your choosing.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "QuesadillAI"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}